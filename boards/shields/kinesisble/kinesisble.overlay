/* MCP23s17 GPIO Expander */
&spi1 {
    status = "okay";
    cs-gpios = <&feather_header 14 1>;
    compatible = "nordic,nrf-spi";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";

    spi_gpio: mcp23s17@0 {
        status = "okay";
        compatible = "microchip,mcp23s17";
        gpio-controller;
        #gpio-cells = <2>;
        // MCP23S17 is rated to 10 MHz; 4 MHz shortens each matrix scan with margin
        spi-max-frequency = <4000000>;
        reg = <0>;
        ngpios = <16>;
    };
};

/* The /uf2 board variant adds a USB serial console; keep it off unless the
 * zmk-usb-logging snippet adds its own. */
&board_cdc_acm_uart {
    status = "disabled";
};

&physical_layout0 {
    transform = <&default_transform>;
};
